generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Non-pooled connection Prisma Migrate uses for DDL/advisory locks —
  // DATABASE_URL is the PgBouncer transaction-mode pooler, which doesn't
  // support those reliably.
  directUrl = env("DIRECT_URL")
}

// ---------- Auth ----------

enum UserRole {
  CUSTOMER
  ADMIN
  // A restricted back-office account — see User.staffMarketScope and
  // lib/rbac.ts's requireStaffOrAdmin. Deliberately a strict allow-list,
  // not "ADMIN minus a few things": every admin page/action keeps its
  // existing requireAdmin() check completely unchanged (catalog,
  // discount codes, settings, customers, etc. all stay ADMIN-only), and
  // STAFF is only ever additionally allowed on the specific
  // order-management actions/pages that explicitly check for it. Adding
  // a new admin capability never implicitly grants it to STAFF — each one
  // has to opt in by name.
  STAFF
}

// Orthogonal to UserRole (which only governs ADMIN vs CUSTOMER access) —
// this is a segmentation/registration-workflow dimension on top of it,
// meaningful only for CUSTOMER accounts. Per product decision, approval
// gates nothing else in the app today: a PENDING wholesale account can
// browse, quote, and buy retail exactly like any other customer. It exists
// so the business has an approval paper-trail and can build wholesale-only
// features on top of it later without another migration.
enum CustomerType {
  RETAIL
  WHOLESALE
}

enum WholesaleStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Meaningful only for STAFF accounts (null otherwise) — which
  // storefront's orders this staff member can see/act on: "intl", "lk",
  // or "both". Set by an admin when creating/editing the staff account
  // (actions/staff.ts). Checked on every staff-permitted order action,
  // never just trusted from what the UI happened to show.
  staffMarketScope String?

  // Meaningful only for STAFF accounts — which back-office areas an admin
  // has switched on for them (see lib/staff-permissions.ts for the list:
  // "orders", "catalog", "requests", "reviews"). An empty list means no
  // access at all. Always combined with staffMarketScope above for
  // anything that has a market.
  staffPermissions String[] @default([])

  // Account suspension, set by an admin. disabledAt set with no disabledUntil
  // is permanent; with a disabledUntil in the future it lifts by itself on
  // that date. See lib/user-status.ts for the one definition of "disabled
  // right now". Blocks sign-in, and cuts off staff access immediately.
  disabledAt     DateTime?
  disabledUntil  DateTime?
  disabledReason String?

  customerType    CustomerType     @default(RETAIL)
  // Null for RETAIL accounts (approval is a wholesale-only concept).
  // PENDING the moment a WHOLESALE registration is submitted — see
  // registerCustomer in actions/auth.ts.
  wholesaleStatus WholesaleStatus?
  businessName    String?
  businessRegNo   String?
  // Set when an admin creates a wholesale account directly with a
  // predefined password (see createWholesaleAccount in actions/wholesale.ts)
  // — never set for a self-registered account, which chose its own
  // password. Cleared the moment they actually change it (changePassword
  // in actions/account.ts). A nudge (notification + a reachable "Change
  // Password" page), not an access gate — this doesn't block anything else
  // in the app while true.
  mustChangePassword Boolean @default(false)

  // Stamped the moment a self-registered account agrees to the Terms &
  // Conditions checkbox at signup (see registerSchema/registerCustomer) —
  // an audit record that they were asked and agreed, not an access gate.
  // Null for an account created another way (e.g. an admin-registered
  // wholesale account), since no signup form was ever shown to agree on.
  termsAcceptedAt DateTime?

  // Both optional — collected at registration or later in account
  // settings. Used only by the birthday promotion (lib/checkout.ts):
  // eligible any day within the birth month, but lastBirthdayDiscountAt
  // (stamped only when an order actually completes, not merely previewed
  // in the cart) blocks a second redemption within the same calendar year.
  dateOfBirth            DateTime?
  lastBirthdayDiscountAt DateTime?

  // Rewards: one stable code per user, minted lazily the first time they
  // open /account/rewards (not at registration — most users never look).
  // referredByCode is stamped once, at account creation, from whichever
  // code (if any) was in the ref_code cookie at the time — see
  // registerCustomer (actions/auth.ts) and the events.createUser hook in
  // lib/auth.ts for the Google sign-up path. pointsBalance is a
  // denormalized cache; the source of truth is the sum of this user's
  // PointsTransaction rows, and every write to pointsBalance happens in
  // the same transaction as the PointsTransaction that justifies it.
  referralCode    String? @unique
  referredByCode  String?
  pointsBalance   Int     @default(0)

  // Wholesale team membership — set only for a WHOLESALE account that's
  // part of a BusinessAccount (the owner who was approved, or a member
  // they invited). Null for every retail/unaffiliated account.
  businessAccountId String?
  businessAccount   BusinessAccount? @relation(fields: [businessAccountId], references: [id])
  businessRole      String?

  accounts        Account[]
  sessions        Session[]
  quoteRequests   QuoteRequest[]
  sourcingRequest SourcingRequest[]
  invoices        Invoice[]
  carts           Cart[]
  cartInvoices    CartInvoice[]
  auctionBids     AuctionBid[]
  chatMessages    ChatMessage[]
  notifications   Notification[]
  // The other side of ChatThread.generalUserId — see its own comment.
  generalChatThread ChatThread? @relation("GeneralSupportThread")

  retailCarts             RetailCart[]
  orders                  Order[]
  refundRequests          RefundRequest[]
  discountCodeRedemptions DiscountCodeRedemption[]
  // Codes minted for this specific customer (DiscountCode.scope ==
  // CUSTOMER) — see DiscountCode.assignedUser below.
  assignedDiscountCodes   DiscountCode[]

  pointsTransactions   PointsTransaction[]
  referralsAsReferrer  Referral[]          @relation("ReferralReferrer")
  referralAsReferee    Referral?           @relation("ReferralReferee")
  ownedBusinessAccount BusinessAccount?    @relation("BusinessAccountOwner")
  passwordResetTokens  PasswordResetToken[]
  wishlistItems        WishlistItem[]
  reviews              Review[]
  jewelryDesigns       JewelryDesign[]
  // Orders this user (a staff/admin account) reverted from PAID back to
  // unpaid — see Order.paymentReversedBy.
  ordersReverted       Order[]              @relation("OrderPaymentReversedBy")

  @@index([businessAccountId])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// A single-use, short-lived, hashed token for the "forgot password" flow
// (src/lib/password-reset.ts) — distinct from NextAuth's own
// VerificationToken above, which belongs to its email-provider sign-in
// flow (not configured in this app) and has no "already used" state, which
// a one-time reset link needs. Only the SHA-256 hash of the raw token is
// ever stored — the raw value exists only in the emailed link and in
// memory for the length of one request — so a database leak alone can't
// be used to take over an account via a still-valid reset link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------- Master data ----------

model Mineral {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  hueMin      Int
  hueMax      Int
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  gemstones Gemstone[]
}

enum CutCategory {
  FACETED
  CABOCHON
}

model Cut {
  id        String      @id @default(cuid())
  name      String      @unique
  slug      String      @unique
  category  CutCategory
  active    Boolean     @default(true)
  sortOrder Int         @default(0)

  gemstones Gemstone[]
}

model ClarityGrade {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  gemstones Gemstone[]
}

model Treatment {
  id        String  @id @default(cuid())
  name      String  @unique
  slug      String  @unique
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  gemstones Gemstone[]
}

model Origin {
  id        String  @id @default(cuid())
  name      String  @unique
  slug      String  @unique
  isCeylon  Boolean @default(false)
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  gemstones Gemstone[]
}

model CertificationLab {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  // Optional online report-verification URL. Contains the literal token
  // `{certId}`, which the storefront substitutes with the gemstone's
  // certReportNumber to build a "Verify Certificate" link — e.g.
  // "https://www.gia.edu/report-check?reportno={certId}". Left blank for
  // labs with no public lookup tool.
  verifyUrlTemplate String?
  websiteUrl        String?
  // Uploaded via the same Supabase Storage upload path as everything else
  // in src/lib/media.ts, not a MediaAsset row — it belongs to the lab
  // itself, not to any one gemstone's gallery.
  logoUrl           String?

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  gemstones Gemstone[]
}

// ---------- Catalog ----------

enum StockStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model Gemstone {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text

  mineralId String
  mineral   Mineral @relation(fields: [mineralId], references: [id])
  variety   String?

  cutId String
  cut   Cut    @relation(fields: [cutId], references: [id])

  caratWeight Float
  lengthMm    Float?
  widthMm     Float?
  depthMm     Float?

  // Configurator-compatible color spec (HSL)
  colorHue        Int
  colorSaturation Int     @default(70)
  colorLightness  Int     @default(50)
  colorLabel      String?

  clarityGradeId String
  clarityGrade   ClarityGrade @relation(fields: [clarityGradeId], references: [id])

  treatmentId String
  treatment   Treatment @relation(fields: [treatmentId], references: [id])

  originId String
  origin   Origin @relation(fields: [originId], references: [id])

  symmetryNotes String?
  polishNotes   String?

  certLabId        String?
  certLab          CertificationLab? @relation(fields: [certLabId], references: [id], onDelete: SetNull)
  certReportNumber String?
  certFileUrl      String?

  // Price is opt-in per item: admins set it and separately choose whether
  // it's shown publicly, or kept as an internal reference for quoting.
  // Defaults keep every existing/new item exactly as before (quote-only,
  // no price shown) until an admin explicitly turns showPrice on.
  price     Float?
  showPrice Boolean @default(false)

  // The retail direct-purchase price — additive to price/showPrice above,
  // not a replacement: an item with retailPrice set gets a "Buy Now" at
  // that price (see lib/retail-cart.ts, lib/checkout.ts) and is preferred
  // by CardPrice/ProductPrice for display; an item still missing it (not
  // yet filled in by an admin) keeps behaving exactly as before, quote-
  // only. costPrice is the real/actual cost, used only to compute the
  // birthday promotion's 10%-off-profit discount (retailPrice - costPrice)
  // — an item with no costPrice recorded simply never gets that discount.
  retailPrice Float?
  costPrice   Float?

  // Which storefront this listing belongs to: "intl" (the international
  // site, dollars) or "lk" (the Sri Lanka store, rupees). Every listing
  // belongs to exactly ONE — the two catalogs never overlap, so an item is
  // only ever shown, searched, added to a cart or curated on its own
  // storefront. Set when the listing is created and not changed afterwards.
  // A "lk" listing must have lkrRetailPrice (enforced in the admin actions).
  market String @default("intl")

  // Prices for a "lk" listing, entered in rupees — nothing is converted
  // from the USD fields above, which a "lk" listing leaves empty.
  // lkrRetailPrice is the buy-now price (mandatory for "lk"); lkrPrice is
  // an optional quote-reference price. costPrice on a "lk" listing is in
  // rupees too. isFeaturedLk is no longer used: isFeatured curates the home
  // page of whichever storefront the listing belongs to.
  lkrRetailPrice Float?
  lkrPrice       Float?
  isFeaturedLk   Boolean @default(false)

  stockStatus StockStatus @default(AVAILABLE)
  isPublished Boolean     @default(true)

  // Curated by admins for the homepage's Featured Gemstones section
  // (independent of isPublished — a piece can be published but not
  // featured). The section itself can be switched off entirely via
  // HomeContent.showFeaturedGems without touching any item's flag.
  isFeatured Boolean @default(false)

  // At most one of these is ever set (not a DB constraint — same
  // convention as this schema's other exclusive-field groups, validated
  // in the admin catalog actions). Neither set: checkout charges this
  // item under the normal destination-based ShippingZone rate, same as
  // before either existed. shippingWeightTierId set: that tier's flat
  // rate replaces the zone rate for this item. quoteShipping: the item
  // still has its own price and can be bought directly, but shipping is
  // $0 at checkout and the resulting Order is flagged
  // shippingToBeArranged so an admin follows up (see lib/checkout.ts,
  // Order.shippingToBeArranged).
  shippingWeightTierId String?
  shippingWeightTier   ShippingWeightTier? @relation(fields: [shippingWeightTierId], references: [id], onDelete: SetNull)
  quoteShipping         Boolean             @default(false)

  media MediaAsset[]

  quoteRequests        QuoteRequest[]
  jewelryGemstoneLink  JewelryGemstoneLink[]
  auctions             Auction[]
  promotionItems       PromotionItem[]
  subcultureItems      SubcultureCollectionItem[]
  taggedInChatMessages ChatMessage[]
  retailCartItems      RetailCartItem[]
  orderItems           OrderItem[]
  wishlistItems        WishlistItem[]
  bundleItems          BundleItem[]
  reviews              Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mineralId])
  @@index([cutId])
  @@index([stockStatus])
  @@index([isFeatured])
  @@index([isFeaturedLk])
  @@index([shippingWeightTierId])
  // Every public catalog query filters exactly this pair (getGemstones,
  // getRelatedGemstones — see lib/catalog.ts) — the single most common
  // storefront query, so it gets a composite index rather than just the
  // standalone `market` this replaces (a market-only filter is still
  // served by this index's leftmost prefix).
  @@index([market, isPublished])
}

enum PieceType {
  RING
  NECKLACE
  EARRINGS
  BRACELET
  PENDANT
  BROOCH
  ANKLET
  JEWELRY_SET
  CUFFLINKS
  OTHER
}

// Who a piece is designed for — the top level of the jewelry catalog
// (Men / Women / Couple / Unisex), above the piece type. See
// lib/jewelry-categories.ts for how Men and Women also include Unisex pieces.
enum JewelryAudience {
  WOMEN
  MEN
  COUPLE
  UNISEX
}

enum MetalType {
  GOLD
  WHITE_GOLD
  ROSE_GOLD
  PLATINUM
  SILVER
}

model JewelryPiece {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text

  pieceType    PieceType
  // Defaults to UNISEX so every piece that existed before this field shows up
  // somewhere sensible; an admin sets the real audience on each piece.
  audience     JewelryAudience @default(UNISEX)
  metalType    MetalType
  metalPurity  String?
  metalWeightG Float?
  ringSize     String?
  styleTags    String[]

  price     Float?
  showPrice Boolean @default(false)

  // See the matching fields on Gemstone above for the full rationale —
  // additive retail-checkout price + real cost for the birthday discount.
  retailPrice Float?
  costPrice   Float?

  // Storefront ("intl" | "lk") and rupee prices — see Gemstone.
  market         String  @default("intl")
  lkrRetailPrice Float?
  lkrPrice       Float?
  isFeaturedLk   Boolean @default(false)

  stockStatus StockStatus @default(AVAILABLE)
  isPublished Boolean     @default(true)

  // Same curation flag as Gemstone.isFeatured, for the homepage's
  // Featured Jewelry section.
  isFeatured Boolean @default(false)

  // A GLB 3D model for the mobile AR "try it on" live neck-tracking
  // feature (NECKLACE/PENDANT only — see ArTryOnButton) — null means no
  // AR for this piece, no separate enabled flag needed. Uploaded via
  // ArModelUploader/actions/ar-models.ts, same single-file-per-item
  // pattern as CertificationLab.logoUrl.
  arModelUrl String?

  // See the matching fields on Gemstone above for the full rationale.
  shippingWeightTierId String?
  shippingWeightTier   ShippingWeightTier? @relation(fields: [shippingWeightTierId], references: [id], onDelete: SetNull)
  quoteShipping         Boolean             @default(false)

  media     MediaAsset[]
  gemstones JewelryGemstoneLink[]

  // Opt-in — a piece with none behaves exactly as before (one buy button,
  // stockStatus on the piece itself). Once a piece has variants, its own
  // stockStatus is kept in sync as a derived summary (AVAILABLE if any
  // variant still is, else SOLD — see the recompute in lib/orders.ts) so
  // every existing catalog/related-items query that filters on it keeps
  // working unchanged; the real per-variant state lives on JewelryVariant.
  variants JewelryVariant[]

  quoteRequests        QuoteRequest[]
  auctions             Auction[]
  promotionItems       PromotionItem[]
  subcultureItems      SubcultureCollectionItem[]
  taggedInChatMessages ChatMessage[]
  retailCartItems      RetailCartItem[]
  orderItems           OrderItem[]
  wishlistItems        WishlistItem[]
  bundleItems          BundleItem[]
  reviews              Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pieceType])
  @@index([audience])
  @@index([stockStatus])
  @@index([isFeatured])
  @@index([isFeaturedLk])
  @@index([shippingWeightTierId])
  // Same reasoning as Gemstone's — see that model's comment.
  @@index([market, isPublished])
}

// A style/size variant of a jewelry piece (e.g. "Size 7", "18-inch chain",
// "Rose Gold") — each with its own stock, so a customer buying one size
// doesn't sell out the others. Label is free text rather than structured
// axes: this catalog is small and pieces vary too much (rings vs.
// necklaces vs. bracelets) for one fixed set of axes to fit all of them.
model JewelryVariant {
  id        String       @id @default(cuid())
  jewelryId String
  jewelry   JewelryPiece @relation(fields: [jewelryId], references: [id], onDelete: Cascade)

  label String

  // Optional overrides — left blank, a variant inherits the parent piece's
  // own price/cost (the common case: same piece, different size). Only the
  // fields for the piece's own market are ever set, same convention as
  // Gemstone/JewelryPiece's own price columns.
  retailPrice    Float?
  lkrRetailPrice Float?
  costPrice      Float?

  stockStatus StockStatus @default(AVAILABLE)
  sortOrder   Int         @default(0)

  retailCartItems RetailCartItem[]
  orderItems      OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jewelryId])
  @@index([stockStatus])
}

model JewelryGemstoneLink {
  id           String       @id @default(cuid())
  jewelryId    String
  jewelry      JewelryPiece @relation(fields: [jewelryId], references: [id], onDelete: Cascade)
  gemstoneId   String?
  gemstone     Gemstone?    @relation(fields: [gemstoneId], references: [id])
  freeformDesc String?

  @@index([jewelryId])
}

enum MediaType {
  IMAGE
  VIDEO
}

model MediaAsset {
  id        String    @id @default(cuid())
  url       String
  type      MediaType
  altText   String?
  isPrimary Boolean   @default(false)
  sortOrder Int       @default(0)

  gemstoneId String?
  gemstone   Gemstone? @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)

  jewelryId String?
  jewelry   JewelryPiece? @relation(fields: [jewelryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([gemstoneId])
  @@index([jewelryId])
}

// ---------- Site content (admin-editable marketing copy) ----------

// One row per editable page ("home", "about", ...). `data` is a loosely-typed
// JSON blob whose shape is owned by the corresponding TS type in
// src/lib/page-content.ts — deliberately not a rigid column-per-field model,
// since marketing copy/images change shape more often than catalog data.
// Missing keys fall back to that page's DEFAULT_*_CONTENT constant, so old
// rows stay valid after new fields are added in code.
model PageContent {
  id        String   @id @default(cuid())
  page      String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

// ---------- Quotes & sourcing ----------

enum QuoteStatus {
  SUBMITTED
  UNDER_REVIEW
  QUOTED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ProductType {
  GEMSTONE
  JEWELRY
  // A free-form bespoke design idea (no existing catalog item or
  // configurator spec) — submitted from a subculture collection page's
  // "Commission a Custom Piece" section. See referenceImages below.
  CUSTOM
}

model QuoteRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  productType ProductType?
  gemstoneId  String?
  gemstone    Gemstone?     @relation(fields: [gemstoneId], references: [id])
  jewelryId   String?
  jewelry     JewelryPiece? @relation(fields: [jewelryId], references: [id])

  // Present when the request originated from the standalone configurator
  // rather than an existing catalog item.
  configuredSpec Json?

  // Customer-attached photos for a CUSTOM (no catalog item/configuredSpec)
  // request — an array of /media/[filename] URLs, same storage path as any
  // other upload (see lib/media.ts saveUploadedMedia). Null/empty for every
  // GEMSTONE/JEWELRY quote, which reference their own catalog images
  // instead.
  referenceImages Json?

  quantity Int     @default(1)
  note     String? @db.Text

  noteFlaggedForPrice Boolean @default(false)
  adminNotes          String? @db.Text

  status QuoteStatus @default(SUBMITTED)

  // Set by the admin alongside (or before) moving status to QUOTED. A flat
  // total for the requested quantity, not a per-unit price — this business
  // is quote-only with one line item per request, so a fuller line-item
  // breakdown would be more structure than the data actually needs.
  quotedPrice     Float?
  quoteValidUntil DateTime?
  quotedAt        DateTime?

  // Created automatically the moment status is set to ACCEPTED (see
  // updateQuoteRequest) — never created directly. A quote can have at most
  // one invoice.
  invoice Invoice?

  // Historical — CartItem was how an accepted quote used to reach payment
  // (bundled with other accepted requests into one Cart, paid by wire).
  // Kept for quotes accepted before ensureOrderForQuote replaced it; a
  // newly-accepted quote gets `order` below instead.
  cartItem CartItem?
  // Set the moment this quote is accepted — see ensureOrderForQuote in
  // lib/orders.ts.
  order    Order?

  // One chat thread per request, created lazily on first message (see
  // getOrCreateChatThread) — not eagerly for every request.
  chatThread ChatThread?

  // Set when this request was produced by the Design Studio (sketched,
  // not just photo-uploaded) — lets the admin reopen the editable design
  // instead of only seeing its flat thumbnail in referenceImages. See
  // JewelryDesign.quoteRequestId.
  jewelryDesign JewelryDesign?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Invoice {
  id            String @id @default(cuid())
  // Sequential per calendar year, e.g. "INV-2026-0007" — generated in
  // createInvoiceForQuote from a count of that year's existing invoices.
  invoiceNumber String @unique

  quoteRequestId String       @unique
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Snapshotted from QuoteRequest.quotedPrice at the moment of acceptance,
  // deliberately not read live off the quote — an invoice is a historical
  // record and shouldn't silently change if the quote is edited afterward.
  amount   Float
  issuedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([userId])
}

enum DesignSource {
  ADMIN
  CUSTOMER
}

// A sketch made in the Design Studio (the 2D "split the canvas, copy a
// segment, repeat it around a band" jewelry layout tool) — see
// src/lib/design-studio/types.ts for the shape of `data`. Staff use this
// freely; a customer only reaches it when an admin has turned the
// "design-studio" PageVisibility key LIVE (src/lib/page-visibility.ts).
model JewelryDesign {
  id     String @id @default(cuid())
  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  name String @default("Untitled design")

  // The full editor state (panes, each pane's shapes) as JSON — the same
  // "just store the JSON" approach QuoteRequest.configuredSpec already
  // uses for the gem configurator.
  data Json

  // PNG snapshot of the canvas at last save, uploaded via
  // lib/media.ts's saveUploadedMedia — used as this design's thumbnail
  // and as the QuoteRequest.referenceImages entry once submitted.
  thumbnailUrl String?

  source DesignSource @default(ADMIN)

  // Set once a customer submits this design as a custom-design request
  // (see actions/design-studio.ts's submitDesignStudioRequest) — lets the
  // admin reopen the *editable* design from that quote's detail page
  // instead of just its flat reference-image thumbnail.
  quoteRequestId String?       @unique
  quoteRequest   QuoteRequest? @relation(fields: [quoteRequestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model SourcingRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  mineralDescription String
  approxSize         String?
  approxCut          String?
  approxColor        String?
  notes              String? @db.Text

  noteFlaggedForPrice Boolean @default(false)
  adminNotes          String? @db.Text

  status QuoteStatus @default(SUBMITTED)

  // Mirrors QuoteRequest's own pricing fields — a sourcing request becomes
  // priceable the same way a quote does, so it can generate a CartItem the
  // same way once accepted (see updateSourcingRequest).
  quotedPrice     Float?
  quoteValidUntil DateTime?
  quotedAt        DateTime?

  // Historical — see QuoteRequest.cartItem's own comment.
  cartItem CartItem?
  // Set the moment this request is accepted — see ensureOrderForSourcing
  // in lib/orders.ts.
  order    Order?

  // See QuoteRequest.chatThread — same lazy-create convention.
  chatThread ChatThread?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ---------- Chat ----------
//
// One thread per quote/sourcing request — created lazily on the first
// message (see getOrCreateChatThread in lib/chat.ts), not eagerly for
// every request. A message can optionally tag a catalog item (any
// gemstone/jewelry, not just the one the request itself is about — "what
// about this ring instead?" is a legitimate thing to ask) or the
// request's customer's cart. The cart tag is a snapshot (taggedCartSnapshot),
// not a live reference — same "historical record, doesn't silently change
// later" rule every other amount field in this schema already follows,
// since by the time a message is read the cart it referenced may have
// changed or been submitted entirely.
//
// No live push — see lib/chat.ts and ChatPanel for why (bridging this
// app's NextAuth sessions to Supabase Realtime's RLS-based channel
// authorization would mean running a second, parallel auth system just
// for this). The chat panel polls on a short interval instead, which
// reads as "live" for this use case without that architectural cost.
model ChatThread {
  id String @id @default(cuid())

  quoteRequestId    String?          @unique
  quoteRequest      QuoteRequest?    @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  sourcingRequestId String?          @unique
  sourcingRequest   SourcingRequest? @relation(fields: [sourcingRequestId], references: [id], onDelete: Cascade)
  // A general "chat with support" thread — not tied to any quote/sourcing
  // request, one per customer (hence @unique). Exactly one of these three
  // FKs is ever set (validated in lib/chat.ts, same "not a DB constraint"
  // convention the other exactly-one-of groups in this schema already
  // use, e.g. ChatMessage's own tag fields below).
  generalUserId String? @unique
  generalUser   User?   @relation("GeneralSupportThread", fields: [generalUserId], references: [id], onDelete: Cascade)
  // A thread for one specific order — any order, not just one created from
  // an accepted quote/sourcing request (see the admin order detail page).
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Last time each side actually opened this thread — an unread count is
  // derived at read time ("messages from the other side created after
  // this"), not tracked per-message, so marking a thread read is one
  // write instead of updating every message row in it.
  lastReadByCustomerAt DateTime?
  lastReadByAdminAt    DateTime?

  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteRequestId])
  @@index([sourcingRequestId])
  @@index([generalUserId])
  @@index([orderId])
}

model ChatMessage {
  id       String     @id @default(cuid())
  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  // Snapshotted at send time — which "side" of the conversation this is,
  // independent of the sender's role ever changing later, and cheaper to
  // render from than joining sender.role on every message every time.
  senderRole UserRole

  // Optional — a message can be pure text, a pure attachment (an empty
  // body with a tag), or both. Exactly one of the three tag fields below
  // is ever set (validated in sendChatMessage, not a DB constraint — same
  // convention CartItem's "exactly one of" origin fields already use).
  body String? @db.Text

  taggedGemstoneId   String?
  taggedGemstone     Gemstone?     @relation(fields: [taggedGemstoneId], references: [id], onDelete: SetNull)
  taggedJewelryId    String?
  taggedJewelry      JewelryPiece? @relation(fields: [taggedJewelryId], references: [id], onDelete: SetNull)
  // { items: [{ label: string, amount: number }], total: number }
  taggedCartSnapshot Json?
  // A formal "let's get on a call about this" request, same tag mechanism
  // as the three above (see ChatTag's "videoCallRequest" variant in
  // actions/chat.ts) — gets its own distinct bubble treatment rather than
  // reading as a plain text message, the way James Allen's on-demand
  // inspection call works, but without building actual video calling:
  // the two sides still coordinate a time/link through the thread itself.
  isVideoCallRequest Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([threadId])
  // Unread counts and a thread's message list filter/sort by thread then time.
  @@index([threadId, createdAt])
  @@index([senderId])
}

enum NotificationType {
  CHAT_REPLY
  STATUS_CHANGE
}

// Customer-facing, in-app only for now (see lib/notifications.ts) — one row
// per event (an admin's chat reply, or their quote/sourcing request's
// status changing) rather than reusing ChatThread's "everything since I
// last opened it" scheme, since a notification is a discrete, individually
// readable/dismissable item (a bell dropdown), not a running count.
// Deliberately customer-only: an admin's equivalent is the unread chat
// counts already surfaced (sortable/searchable) in /admin/messages.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  message String

  // Same requestType/requestId discriminator lib/chat.ts's ChatRequestType
  // uses, plus "order" (a payment/cancellation update, which has no chat
  // thread of its own) — enough to link back to whatever this is about
  // without a second nullable-FK-pair the way ChatThread needs.
  requestType String
  requestId   String

  readAt    DateTime?
  // Set when the customer dismisses it from the bell — distinct from readAt:
  // "read" just tracks whether it counts toward the badge, "dismissed" is
  // "stop showing me this at all." A dismissed notification never appears
  // again, whether or not it was ever read first.
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, dismissedAt])
}

// ---------- Rewards: loyalty points, referrals, business accounts ----------
//
// One unified points ledger backs both loyalty (earn on purchase, redeem
// at checkout) and referrals (a referral bonus is just points, same
// balance, same redemption). User.pointsBalance is a denormalized cache;
// this table is the source of truth. amount is signed — positive rows
// earn, negative rows spend/reverse — so the balance is always this
// table's sum for the user, and every write to it happens in the same
// transaction as the User.pointsBalance update it justifies.
enum PointsTransactionReason {
  EARNED_PURCHASE
  REDEEMED_CHECKOUT
  REFERRAL_BONUS_REFERRER
  REFERRAL_BONUS_REFEREE
  ADMIN_ADJUSTMENT
  // The one-time post-purchase "dig for a gem" game — see lib/gem-dig.ts.
  GEM_DIG_BONUS
}

model PointsTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount Int
  reason PointsTransactionReason

  // Set for EARNED_PURCHASE/REDEEMED_CHECKOUT rows — which order this
  // transaction came from. Not a relation (an Order can outlive a lookup
  // need here, and this is purely a display reference, same convention as
  // DiscountCodeRedemption.orderId).
  orderId String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// A customer's saved-for-later items — shown on their own /account/wishlist
// page and toggled with a heart button on every catalog card/product page.
model WishlistItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Exactly one of these two, same convention as OrderItem/RetailCartItem.
  // Not a DB constraint (same call this schema already makes for e.g.
  // ShippingWeightTier/quoteShipping's exclusive pair) — the toggle action
  // checks-then-writes instead; a rare double-click race could in
  // principle create a duplicate row for the same item, but there's no
  // financial stakes here, and a second toggle still removes one of them.
  gemstoneId String?
  gemstone   Gemstone?     @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)
  jewelryId  String?
  jewelry    JewelryPiece? @relation(fields: [jewelryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([gemstoneId])
  @@index([jewelryId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// A real, verified-purchase review — never fabricated, matching this
// app's standing rule. Eligibility is checked live in submitReview (lib/
// reviews.ts): the reviewer must have an Order containing this exact
// item that's reached at least PAID, re-verified at submission time
// rather than trusted from whatever prompted it. Admin-moderated (starts
// PENDING) before it's ever shown on the item's own product page. One
// review per (user, item) — same "exactly one of these two" convention
// as WishlistItem above — so a repeat purchase of the same listing
// doesn't let someone post a second review of it.
model Review {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  gemstoneId String?
  gemstone   Gemstone?     @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)
  jewelryId  String?
  jewelry    JewelryPiece? @relation(fields: [jewelryId], references: [id], onDelete: Cascade)

  rating Int // 1-5
  body   String? @db.Text

  status     ReviewStatus @default(PENDING)
  // Admin's own note on why a review was rejected, or anything else
  // worth recording — never shown to the customer, purely an internal
  // paper trail.
  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gemstoneId])
  @@unique([userId, jewelryId])
  @@index([gemstoneId, status])
  @@index([jewelryId, status])
  @@index([status])
}

enum ReferralStatus {
  // Signed up with a referral code; hasn't placed a qualifying order yet.
  PENDING
  // Reserved for a future "order placed but below the minimum" distinction;
  // not written by anything yet — REWARDED is the only transition PENDING
  // currently makes.
  QUALIFIED
  // Placed a qualifying order — both sides have been paid their bonus.
  REWARDED
}

// One row per referred signup — created the moment someone registers (or
// completes Google sign-up) with a valid ref_code cookie set, and moved to
// REWARDED once their first qualifying order is paid (see
// finalizePaidOrder in lib/orders.ts). refereeId is unique: a person can
// only ever be someone's referee once, on their very first account.
model Referral {
  id String @id @default(cuid())

  referrerId String
  referrer   User   @relation("ReferralReferrer", fields: [referrerId], references: [id])
  refereeId  String @unique
  referee    User   @relation("ReferralReferee", fields: [refereeId], references: [id])

  // The code as it was at signup — referrer.referralCode could theoretically
  // change identity if the user row were ever deleted/recreated, so this is
  // snapshotted rather than re-derived.
  code   String
  status ReferralStatus @default(PENDING)

  qualifyingOrderId String?
  qualifiedAt       DateTime?
  createdAt         DateTime  @default(now())

  @@index([referrerId])
}

// A wholesale team — created the moment an admin approves a wholesale
// application (see actions/wholesale.ts), with the applicant as OWNER.
// Members share one team, visible at /account/business, without touching
// any member's own personal /account/orders or other personal views — see
// User.businessAccountId/businessRole and Order.businessAccountId.
model BusinessAccount {
  id      String @id @default(cuid())
  name    String
  ownerId String @unique
  owner   User   @relation("BusinessAccountOwner", fields: [ownerId], references: [id])

  members User[]
  orders  Order[]

  createdAt DateTime @default(now())
}

// Singleton settings row (mirrors CommerceSettings) — the admin-editable
// knobs for the whole rewards program. LKR orders convert through
// CommerceSettings.usdToLkrRate, the app's one existing cross-currency
// reference point, rather than a second rate living here.
model LoyaltySettings {
  id String @id @default("singleton")

  // Points earned per whole USD spent (order.subtotal, international
  // store only — see pointsPerCurrencyUnitLkr for /lk) — 1 = one point
  // per dollar spent.
  pointsPerCurrencyUnit Float @default(1)
  // USD value of a single point when redeemed at checkout on the
  // international store, e.g. 0.01 = 100 points redeem for $1.
  pointsRedemptionValue Float @default(0.01)
  // The Sri Lanka store's own native rates — kept separate rather than
  // converted through CommerceSettings.usdToLkrRate, so a customer's
  // rupee point value doesn't silently drift every time that exchange
  // rate is updated. Default keeps the same ~1% earn-and-redeem economics
  // as the international rates (0.01 pts per Rs 1 spent = 1 pt per Rs
  // 100; 1 pt = Rs 1 on redemption), just expressed natively.
  pointsPerCurrencyUnitLkr Float @default(0.01)
  pointsRedemptionValueLkr Float @default(1)
  // A customer can't redeem a token handful of points — keeps the "Use my
  // points" control from being offered for a balance too small to matter.
  minRedeemPoints Int @default(500)
  // Caps how much of a single order's total points can cover, so an order
  // can never be driven all the way to zero.
  maxRedeemPercentOfOrder Float @default(50)

  // A referral only pays out once the referee's first order reaches PAID
  // and its subtotal meets this minimum (in the referee's own order
  // currency) — guards against a throwaway $1 order farming bonuses.
  referralMinOrderValue        Float @default(50)
  referralReferrerBonusPoints  Int   @default(500)
  referralRefereeBonusPoints   Int   @default(250)

  updatedAt DateTime @updatedAt
}

// ---------- Cart & payment ----------
//
// A customer has at most one OPEN cart at a time (enforced in
// lib/cart.ts's getOrCreateOpenCart, not by a DB constraint — Prisma has
// no partial/conditional unique index, and this app has no concurrent-
// request risk worth one). Accepting a quote or sourcing request (see
// updateQuoteRequest/updateSourcingRequest in actions/admin-requests.ts)
// adds a CartItem to that open cart automatically. The customer reviews
// their cart and submits it (OPEN -> SUBMITTED) when ready to pay by wire
// transfer; submitting starts a fresh OPEN cart for anything accepted
// afterward. Payment itself happens outside the app (a bank wire) — an
// admin flips paymentStatus to PAID once it's confirmed received.

enum CartStatus {
  OPEN
  SUBMITTED
}

enum PaymentStatus {
  AWAITING_PAYMENT
  PAID
}

model Cart {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  status        CartStatus    @default(OPEN)
  paymentStatus PaymentStatus @default(AWAITING_PAYMENT)

  submittedAt DateTime?
  // Set when an admin marks paymentStatus PAID — see markCartPaid.
  paidAt      DateTime?

  // Snapshotted from DiscountCode.amountOff at the moment the code is
  // applied (see applyDiscountCode) — same "historical record, doesn't
  // silently change later" reasoning every other amount field in this
  // schema already uses. Null means no code is applied. The cart total is
  // sum(items.amount) - discountAmount, floored at 0 rather than allowing
  // a code larger than the cart to go negative.
  discountAmount Float?

  items   CartItem[]
  invoice CartInvoice?

  // Forward FK (not the old reverse 1:1) — see DiscountCode below: a code
  // can now apply to many carts/orders over its lifetime (up to maxUses),
  // so the "currently applied to" relationship lives on the applier
  // (Cart/Order), not on the code itself.
  discountCodeId String?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([discountCodeId])
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  // Exactly one of these three is set — a cart item always originates
  // from an accepted QuoteRequest, an accepted SourcingRequest, or an
  // admin-confirmed Auction win, never more than one and never none.
  quoteRequestId String?       @unique
  quoteRequest   QuoteRequest? @relation(fields: [quoteRequestId], references: [id])

  sourcingRequestId String?          @unique
  sourcingRequest   SourcingRequest? @relation(fields: [sourcingRequestId], references: [id])

  auctionId String?  @unique
  auction   Auction? @relation(fields: [auctionId], references: [id])

  // Snapshotted at the moment the item was added — same "historical
  // record, doesn't silently change later" reasoning Invoice.amount
  // already uses.
  label  String
  amount Float

  createdAt DateTime @default(now())

  @@index([cartId])
}

model CartInvoice {
  id            String @id @default(cuid())
  // Sequential per calendar year, distinct prefix from the older
  // per-quote Invoice ("INV-2026-...") so the two are never visually
  // confusable — this document can cover several quotes/sourcing
  // requests at once, that one never does.
  invoiceNumber String @unique

  cartId String @unique
  cart   Cart   @relation(fields: [cartId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Snapshotted sum of the cart's items (less any applied discount,
  // floored at 0) at generation time.
  amount   Float
  issuedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([userId])
}

// Fixed-amount-off discount codes. Generated by an admin (see
// actions/discount-codes.ts). A percentage-off model isn't supported; per
// the brief, this is "one amount off" only — but scope/limit/expiry are:
// SITE_WIDE (anyone) or CUSTOMER (only assignedUser), an optional maxUses
// (null = unlimited) tracked by usesCount, and an optional expiresAt.
//
// Redemption is tracked in DiscountCodeRedemption, not on this row — a
// code can be "currently applied" to many open carts/orders at once
// (Cart.discountCodeId / Order.discountCodeId are plain FKs, no
// uniqueness), but only counts toward usesCount once a cart/order actually
// completes (see applyDiscountCode / lib/checkout.ts). This replaces the
// old one-code-one-cart-forever model.
enum DiscountScope {
  SITE_WIDE
  CUSTOMER
}

model DiscountCode {
  id   String @id @default(cuid())
  // Stored and matched uppercase — codes are case-insensitive from a
  // customer's point of view (see lib/discount-codes.ts's normalizeCode).
  code String @unique

  amountOff Float
  // The same code's value on the Sri Lanka store, in rupees. Null means the
  // code isn't valid on /lk (amountOff is USD and isn't converted).
  amountOffLkr Float?

  scope          DiscountScope @default(SITE_WIDE)
  assignedUserId String?
  assignedUser   User?         @relation(fields: [assignedUserId], references: [id])

  maxUses   Int?
  usesCount Int  @default(0)

  expiresAt DateTime?
  // Manual kill switch — an admin can disable a code without deleting its
  // redemption history.
  active    Boolean   @default(true)

  carts       Cart[]
  orders      Order[]
  redemptions DiscountCodeRedemption[]

  createdAt   DateTime     @default(now())
  retailCarts RetailCart[]

  @@index([code])
  @@index([assignedUserId])
}

// One row per completed redemption — written only when the cart/order
// that applied the code actually finishes (wholesale cart submitted,
// retail order paid), which is also the moment DiscountCode.usesCount
// increments. Merely applying-then-removing a code from a still-open
// cart never creates one of these, so it never burns a use.
model DiscountCodeRedemption {
  id             String       @id @default(cuid())
  discountCodeId String
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  // Exactly one of these two — which pipeline redeemed the code.
  cartId  String?
  orderId String?

  redeemedAt DateTime @default(now())

  @@index([discountCodeId])
  @@index([userId])
}

// ---------- Page visibility ----------
//
// A generic, reusable on/off/teaser switch for pages that don't always
// exist publicly — the seasonal promotions page today, the auction page
// next. `key` is a plain string (not its own enum) rather than adding a
// column per gated page, so a future page just picks a new key with no
// migration. HIDDEN: the route 404s, as if it didn't exist. COMING_SOON:
// the route renders a themed teaser instead of the real content. LIVE:
// the real page. See lib/page-visibility.ts.
enum PageVisibilityState {
  HIDDEN
  COMING_SOON
  LIVE
}

model PageVisibility {
  id    String              @id @default(cuid())
  key   String              @unique
  state PageVisibilityState @default(HIDDEN)

  updatedAt DateTime @updatedAt
}

// ---------- Auctions ----------
//
// Highest bid wins, gated by a hidden reserve price — an auction that
// closes without a bid meeting the reserve has no winner. Bidding is
// provisional: the customer with the highest bid at close doesn't
// automatically get anything — an admin reviews and confirms the winner
// (see confirmAuctionWinner in actions/auctions.ts), the same "admin has
// the final say" shape as quote acceptance. Confirming a winner drops a
// CartItem into their open cart — from there the existing cart/wire-
// transfer/invoice pipeline (lib/cart.ts, lib/invoicing.ts) handles the
// rest untouched; an auction win is just a third way a CartItem gets
// created, alongside an accepted QuoteRequest or SourcingRequest.
//
// Timing is computed, not stored or cron'd — see lib/auctions.ts's
// getAuctionState. `status` here only tracks admin-driven transitions
// (Draft -> Active, or Cancelled/Won); whether an Active auction is
// currently open for bids, closed and awaiting confirmation, or closed
// with no winner is derived from startsAt/endsAt/reservePrice/bids at
// read time, same "don't need a job just to flip a flag on a schedule"
// reasoning PageVisibility and quoteValidUntil already follow.
enum AuctionStatus {
  DRAFT
  ACTIVE
  CANCELLED
  WON
  // The winner missed the 24-hour payment window — set when an admin
  // cancels the still-unpaid order of a WON auction (cancelOrderAsAdmin),
  // which also releases the item back to AVAILABLE.
  // Distinct from CANCELLED (an admin's own decision, any time).
  EXPIRED
}

model Auction {
  id String @id @default(cuid())

  // Exactly one of these two — same convention as CartItem's
  // quoteRequestId/sourcingRequestId pair.
  gemstoneId String?
  gemstone   Gemstone?     @relation(fields: [gemstoneId], references: [id])
  jewelryId  String?
  jewelry    JewelryPiece? @relation(fields: [jewelryId], references: [id])

  startingPrice Float
  // Never rendered on the public auction page — only the admin sees it.
  // A bid at or above this is what turns "highest bid at close" into an
  // eligible winner; below it, the auction closes with no winner.
  reservePrice  Float
  // Minimum amount a new bid must clear the current highest by (or clear
  // startingPrice by, for the first bid).
  bidIncrement  Float @default(50)

  startsAt DateTime
  endsAt   DateTime

  status AuctionStatus @default(DRAFT)
  // Stamped when an admin confirms the winner (see confirmAuctionWinner)
  // — the 24-hour payment window is computed from this, not stored
  // separately, so it's always exactly "confirmed + 24h."
  wonAt    DateTime?

  bids     AuctionBid[]
  cartItem CartItem?
  order    Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gemstoneId])
  @@index([jewelryId])
  @@index([status])
}

model AuctionBid {
  id        String  @id @default(cuid())
  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  amount Float

  createdAt DateTime @default(now())

  @@index([auctionId])
  @@index([userId])
}

// ---------- Promotional items ----------
//
// A curated set of catalog items to feature on the seasonal promotions
// page (see lib/promotion-items.ts), each carrying its own discounted
// promoPrice — display-only, same "quote-only, no real checkout" model
// as the rest of the catalog: a customer still requests a quote from the
// item's own product page, same as any other item.
//
// Scoped per theme, not global: the same item can be in more than one
// theme's collection at once (each with its own price — a bigger cut in
// one season than another is a legitimate choice, not a bug), but only
// once within a given theme. `theme` is a plain string validated against
// SEASONAL_THEME_KEYS at the app level (see addPromotionItem), same
// "no enum, no migration for a future key" convention PageVisibility.key
// already uses. `@@unique([theme, gemstoneId])` (and the jewelry
// equivalent) enforces the "once per theme" rule — Postgres treats every
// NULL as distinct under a unique index, so each constraint only ever
// binds the non-null side of whichever column a given row actually uses.
model PromotionItem {
  id    String @id @default(cuid())
  theme String

  gemstoneId String?
  gemstone   Gemstone?     @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)
  jewelryId  String?
  jewelry    JewelryPiece? @relation(fields: [jewelryId], references: [id], onDelete: Cascade)

  // Which storefront this promotion belongs to ("intl" | "lk"); promoPrice
  // is in that market's currency. The Sri Lanka store runs its own seasonal
  // promotion (PageContent key "lk:seasonal") with its own item list.
  market     String @default("intl")
  promoPrice Float
  sortOrder  Int    @default(0)

  createdAt DateTime @default(now())

  @@unique([theme, gemstoneId, market])
  @@unique([theme, jewelryId, market])
  @@index([gemstoneId])
  @@index([jewelryId])
  @@index([theme])
}

// An admin-curated set of 2+ existing catalog items ("Sapphire Ring +
// Matching Studs") sold at a combined price lower than buying each
// separately — the discount applies automatically once every item in the
// set is in the same cart, the same mechanism a DiscountCode applies (see
// lib/checkout.ts's buildCheckoutBreakdown), not a new cart/order line
// type. Each item still checks out as its own ordinary OrderItem, so
// inventory reservation, profit tracking, and refunds all keep working
// completely unchanged — this is a pricing rule layered on top, not a new
// kind of product.
model Bundle {
  id    String @id @default(cuid())
  name  String

  // Fixed per row, same convention as Gemstone/JewelryPiece.market — a
  // bundle only ever discounts its own storefront's cart, and `price`
  // below is in that market's own currency (no cross-market conversion).
  market  String @default("intl")
  price   Float
  active  Boolean @default(true)
  sortOrder Int @default(0)

  items BundleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([market, active])
}

model BundleItem {
  id       String @id @default(cuid())
  bundleId String
  bundle   Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  // Exactly one of these two, same convention as OrderItem/RetailCartItem.
  gemstoneId String?
  gemstone   Gemstone?     @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)
  jewelryId  String?
  jewelry    JewelryPiece? @relation(fields: [jewelryId], references: [id], onDelete: Cascade)

  @@index([bundleId])
  @@index([gemstoneId])
  @@index([jewelryId])
}

// ---------- Alternative (subculture) collections ----------
//
// Hidden-by-default landing pages at /collections/[slug] targeting
// alternative-fashion subcultures (Goth, Vampire/Gothic Fantasy, Dark
// Academia, Metal/Rock, Witchy/Occult) — never linked from the main nav,
// only reachable by direct URL. Visibility is tracked per collection via
// PageVisibility (key == this row's `collection`), same on/off mechanism
// PromotionItem's page already uses. Unlike PromotionItem, all five
// collections can be enabled independently at once (no single "active"
// one), so there's no promoPrice here — this is pure curation, not a
// discount collection — and `featured` replaces it, for the admin to
// highlight a handful of items within a collection's own grid.
//
// `collection` is a plain string validated at the app level against
// SUBCULTURE_KEYS (src/lib/subculture-collections.ts), the same
// no-enum-no-migration-for-a-new-key convention PromotionItem.theme and
// PageVisibility.key already use — adding a sixth subculture later is a
// code change, not a migration.
model SubcultureCollectionItem {
  id         String @id @default(cuid())
  collection String

  gemstoneId String?
  gemstone   Gemstone?     @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)
  jewelryId  String?
  jewelry    JewelryPiece? @relation(fields: [jewelryId], references: [id], onDelete: Cascade)

  // Curated highlight within this collection's own grid — independent of
  // Gemstone.isFeatured/JewelryPiece.isFeatured, which drive the
  // homepage's own featured sections.
  featured  Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([collection, gemstoneId])
  @@unique([collection, jewelryId])
  @@index([gemstoneId])
  @@index([jewelryId])
  @@index([collection])
}

// ---------- Retail commerce ----------
//
// A second, parallel purchase pipeline alongside the wholesale
// quote -> accept -> Cart -> wire-transfer flow above, which stays
// untouched. Retail customers add items directly at their live
// retailPrice (RetailCart/RetailCartItem — one persistent cart per user,
// re-validated against current prices at checkout, never a price
// snapshot), then check out through PayHere (Order/OrderItem, a snapshot
// at the moment of purchase, same convention Invoice/CartItem already
// use). See lib/retail-cart.ts and lib/checkout.ts.

model RetailCart {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // One cart per market so rupee and dollar prices never mix in a cart.
  market String @default("intl")

  items RetailCartItem[]

  // Same forward-FK convention as Cart.discountCode above.
  discountCodeId String?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])

  // How many rewards points the customer has staged to redeem on this
  // cart's checkout — same "apply only previews, finalize is what
  // actually redeems" split as discountCodeId (see lib/checkout.ts,
  // actions/retail-cart.ts). Clamped against the live balance and the
  // order's own cap every time the breakdown is built, so a stale value
  // here never overspends.
  pointsToRedeem Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, market])
  @@index([discountCodeId])
}

model RetailCartItem {
  id     String     @id @default(cuid())
  cartId String
  cart   RetailCart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  // Exactly one of these two, same convention as CartItem/OrderItem.
  gemstoneId String?
  gemstone   Gemstone?     @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)
  jewelryId  String?
  jewelry    JewelryPiece? @relation(fields: [jewelryId], references: [id], onDelete: Cascade)
  // Set only when jewelryId is and the piece has variants — which specific
  // one this line is for (see JewelryVariant). A piece with no variants
  // never sets this, same as before variants existed.
  jewelryVariantId String?
  jewelryVariant   JewelryVariant? @relation(fields: [jewelryVariantId], references: [id], onDelete: Cascade)

  quantity  Int   @default(1)
  // Price at the moment this line was added — display only. Checkout
  // (lib/checkout.ts) always re-reads the item's live retailPrice rather
  // than trusting this, so a cart never checks out at a stale price.
  unitPrice Float

  createdAt DateTime @default(now())

  @@unique([cartId, gemstoneId])
  // Not [cartId, jewelryId] alone: two different variants of the same piece
  // must be addable to the same cart side by side. A non-varianted piece's
  // line always has jewelryVariantId = null, and Postgres treats distinct
  // NULLs as non-conflicting here — addToRetailCart's own findFirst-before-
  // create is what actually prevents a duplicate line in that case, not
  // this constraint (see actions/retail-cart.ts).
  @@unique([cartId, jewelryId, jewelryVariantId])
  @@index([cartId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CANCELLED
  // Admin enters carrier + tracking number by hand (lib/orders.ts's
  // markOrderShipped) — only reachable from PAID. If a 17track API key is
  // configured the tracking number is also registered with them
  // best-effort, and their webhook (app/api/17track/webhook) can advance
  // an order straight to DELIVERED; otherwise an admin marks it by hand.
  SHIPPED
  DELIVERED
  // A staff/admin correction: this order was marked PAID by mistake, or
  // the payment didn't actually land (e.g. a wire transfer bounced after
  // being confirmed) — see lib/orders.ts's revertOrderToUnpaid. Distinct
  // from PENDING_PAYMENT on purpose: a customer here should never see the
  // normal "complete payment" prompt, since none of what already happened
  // (item marked sold, points earned, discount code redeemed) is
  // automatically undone — that's a deliberate "flag for admin review,
  // don't auto-reverse" choice, the same one shippingToBeArranged/
  // needsPointsApproval already make elsewhere on this model, since
  // clawing back points a customer may have already spent could push
  // their balance negative.
  PAYMENT_REVERSED
}

enum PaymentMethod {
  PAYHERE_CARD
  WIRE_TRANSFER
  COD
  // Recorded by an admin for a sale that happened outside the system (an
  // in-person/offline sale) — see Order.manualSale. Not offered on the
  // customer-facing checkout form (payment-methods.ts's own list).
  CASH
}

model Order {
  id          String @id @default(cuid())
  // Sequential per calendar year, e.g. "ORD-2026-0007" — same convention
  // as Invoice.invoiceNumber/CartInvoice.invoiceNumber (see lib/invoicing.ts).
  orderNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  items OrderItem[]

  // "LKR" for a Sri Lanka shipping address, "USD" for everywhere else in
  // this pass (see lib/checkout.ts) — every amount below is in this
  // currency.
  currency String

  subtotal               Float
  discountAmount         Float @default(0)
  birthdayDiscountAmount Float @default(0)
  // Sum of every matching Bundle's discount on this order — see Bundle's
  // own schema comment. A snapshot like discountAmount/birthdayDiscountAmount
  // above, not a link to which Bundle(s) applied (a cart could in
  // principle match more than one).
  bundleDiscountAmount   Float @default(0)
  taxAmount              Float @default(0)
  shippingAmount         Float @default(0)
  handlingFeeAmount      Float @default(0)
  // Rewards points spent on this order — snapshotted at creation the same
  // way discountAmount is, even though the actual balance deduction (a
  // PointsTransaction, mirroring finalizeDiscountRedemption's hard
  // recheck) only happens once the order is finalized PAID. See
  // lib/checkout.ts / lib/orders.ts.
  pointsRedeemed         Int   @default(0)
  pointsDiscountAmount   Float @default(0)
  total                  Float

  // Shipping address, snapshotted at checkout — never a live reference.
  shipName         String
  shipPhone        String
  shipCountry      String
  shipCity         String
  shipAddressLine1 String
  shipAddressLine2 String?
  shipPostalCode   String?

  status OrderStatus @default(PENDING_PAYMENT)

  // Which storefront the order was placed on, and how it's being paid.
  // A WIRE_TRANSFER order stays PENDING_PAYMENT (its items RESERVED) until
  // an admin confirms the transfer landed — see lib/orders.ts.
  market        String        @default("intl")
  paymentMethod PaymentMethod @default(PAYHERE_CARD)

  paymentGateway   String    @default("payhere")
  // PayHere's own payment id, set once their notify webhook confirms
  // success (see app/api/payhere/notify/route.ts).
  gatewayPaymentId String?
  paidAt           DateTime?

  // Entered by hand by an admin (lib/orders.ts's markOrderShipped) —
  // trackingUrl is the carrier's own tracking page, admin-entered too
  // since a per-carrier URL template isn't worth maintaining for the
  // small set of carriers this business actually ships with. When a
  // 17track API key is configured the number is also registered with
  // them (best-effort — see lib/track17.ts) for automatic delivery
  // detection via their webhook; without one, an admin marks DELIVERED
  // by hand from the same place.
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  // Set only by revertOrderToUnpaid (lib/orders.ts) — see
  // OrderStatus.PAYMENT_REVERSED's own comment for why this is a flag,
  // not an automatic reversal of everything finalizePaidOrder did.
  // paymentReversedById is SetNull (not Cascade) so this audit trail
  // survives a staff account later being deleted.
  paymentReversedAt     DateTime?
  paymentReversedById   String?
  paymentReversedBy     User?     @relation("OrderPaymentReversedBy", fields: [paymentReversedById], references: [id], onDelete: SetNull)
  // The required message a staff/admin gives when reverting — shown as a
  // banner on the customer's own order page (see the account order detail
  // page) and also posted into the order's chat thread, so the
  // conversation about it naturally continues from there.
  paymentReversedReason String?

  discountCodeId String?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])

  // Set the moment an admin accepts a quote/sourcing request — see
  // ensureOrderForQuote/ensureOrderForSourcing in lib/orders.ts, which
  // replaced the old accept-time CartItem for these two request types.
  // Exactly one of these three is ever set; never more than one, and none
  // for an order placed through normal checkout.
  quoteRequestId    String?          @unique
  quoteRequest      QuoteRequest?    @relation(fields: [quoteRequestId], references: [id])
  sourcingRequestId String?          @unique
  sourcingRequest   SourcingRequest? @relation(fields: [sourcingRequestId], references: [id])
  // Set when this order was created from a confirmed auction win (see
  // ensureOrderForAuctionWin in lib/orders.ts) — same idea, fed by the
  // winning bid instead of a quoted price. A 24-hour payment window starts
  // at Auction.wonAt; nothing enforces it automatically — an admin cancels
  // this order (releasing the item) if it is still unpaid, which also
  // marks the auction EXPIRED.
  auctionId String? @unique
  auction   Auction? @relation(fields: [auctionId], references: [id])
  // True from creation until the customer fills in shipCountry/shipCity/etc
  // themselves (see actions/orders.ts's submitOrderShippingDetails) — a
  // quote/sourcing request never collects a shipping address the way
  // checkout does, so this order exists (and is visible/searchable in
  // admin/orders) before it has one. Blocks markOrderPaid/markOrderShipped
  // until cleared.
  needsShippingDetails Boolean @default(false)

  // True when this order contains at least one item marked quoteShipping
  // (Gemstone/JewelryPiece) — shipping was charged as $0 at checkout
  // rather than a real figure, so an admin needs to follow up with the
  // customer (the order's own chat thread, see below) to arrange and
  // communicate the actual cost. Never cleared automatically; an admin
  // clears it once that's been sorted out (see actions/orders.ts).
  shippingToBeArranged Boolean @default(false)

  // Set at checkout when the points redeemed on this order cover more
  // than its actual profit margin (see needsPointsApproval in
  // lib/checkout.ts) — a paper-trail flag only: the order still
  // completes, pays, and settles points normally either way (same
  // "flag, don't block" pattern as shippingToBeArranged above). An admin
  // clears it once reviewed (see actions/orders.ts).
  needsPointsApproval Boolean @default(false)

  // The one-time post-purchase "dig for a gem" reward game (see
  // lib/gem-dig.ts) — null until played, and only offered once per
  // order. gemDigPointsAwarded is the actual bonus rolled (1-5% of the
  // order's own profit margin, converted to points), recorded here so
  // the result page can show it again without re-rolling.
  gemDigPlayedAt      DateTime?
  gemDigPointsAwarded Int?

  // One thread per order, created lazily on the first message — see
  // getOrCreateChatThread("order", ...) in lib/chat.ts and the admin order
  // detail page.
  chatThread ChatThread?

  // Set from the placing user's businessRole/businessAccountId at
  // checkout, if any — lets a BusinessAccount owner see every order their
  // team placed (/account/business) without touching each member's own
  // personal /account/orders, which only ever shows their own orders
  // regardless of this field.
  businessAccountId String?
  businessAccount   BusinessAccount? @relation(fields: [businessAccountId], references: [id])

  // An admin-recorded in-person/offline sale (see lib/orders.ts's
  // createManualSaleOrder) rather than one placed through normal
  // checkout — created already PAID, no cart/discount code/shipping-form
  // involved. manualPaymentReference/manualReceiptUrl only apply to a
  // manual sale paid by bank transfer (paymentMethod WIRE_TRANSFER);
  // for CASH they're unused.
  manualSale              Boolean @default(false)
  manualPaymentReference  String?
  manualReceiptUrl        String?

  // Stamped when this order was placed through the checkout form's own
  // Terms & Conditions checkbox (see shippingSchema/initiateRetailCheckout)
  // — an order-level audit record, separate from User.termsAcceptedAt
  // (signup-time agreement), since a returning customer re-agrees at
  // every checkout, not just once. Null for an order created another way
  // (quote/sourcing/auction win/manual sale), where no checkout form was
  // ever shown.
  termsAcceptedAt DateTime?

  refundRequest RefundRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([discountCodeId])
  @@index([businessAccountId])
  @@index([market])
  // Serves the admin analytics dashboard's "paid orders in the last N
  // months" query (status: PAID, paidAt: { gte }) — previously unindexed.
  @@index([status, paidAt])
  // The 17track webhook looks an order up by its tracking number.
  @@index([trackingNumber])
}

enum RefundReason {
  DAMAGED
  NOT_AS_DESCRIBED
  CHANGED_MIND
  WRONG_ITEM
  OTHER
}

enum RefundStatus {
  REQUESTED
  REFUNDED
  DENIED
}

enum RefundResolution {
  FULL
  MINUS_SHIPPING
  PARTIAL
}

// A customer-started refund/return on an order (see lib/refunds.ts) — the
// conversation itself happens in the order's own existing ChatThread
// (ChatThread.orderId; see lib/chat.ts's "order" request type), so this
// model only tracks the request's own reason and how an admin finalized
// it, not the back-and-forth. One per order (@@unique) — a second request
// on the same order isn't supported in this first pass.
model RefundRequest {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  reason      RefundReason
  reasonNotes String?      @db.Text

  status RefundStatus @default(REQUESTED)

  // Set together when an admin resolves the request (see
  // resolveRefundRequest in actions/refunds.ts). resolution determines how
  // refundAmount was computed (FULL = order.total, MINUS_SHIPPING =
  // order.total - order.shippingAmount, PARTIAL = an admin-entered
  // figure) — kept as its own field rather than re-derived, since the
  // order's own shippingAmount could theoretically change in meaning over
  // time and this is a settled, historical figure.
  resolution   RefundResolution?
  refundAmount Float?
  // Whether resolving released the returned item(s) back to AVAILABLE —
  // admin's own call (a damaged/non-returnable item might be refunded
  // without restocking), not automatic.
  restocked    Boolean           @default(false)
  adminNotes   String?           @db.Text
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Exactly one of these two.
  gemstoneId String?
  gemstone   Gemstone?     @relation(fields: [gemstoneId], references: [id])
  jewelryId  String?
  jewelry    JewelryPiece? @relation(fields: [jewelryId], references: [id])
  // Same as RetailCartItem's — which variant was actually bought, when the
  // piece has any. SetNull (not Cascade) so a variant an admin later
  // deletes doesn't erase this order's own history — label/unitPrice here
  // are already a snapshot independent of the variant row.
  jewelryVariantId String?
  jewelryVariant   JewelryVariant? @relation(fields: [jewelryVariantId], references: [id], onDelete: SetNull)

  label     String
  unitPrice Float
  quantity  Int
  lineTotal Float

  @@index([orderId])
}

// Admin-editable EMS shipping rate table — there's no public rate API, so
// this is a flat per-order rate per destination zone rather than a live
// carrier lookup. Exactly one row should have isFallback = true (matched
// when the shipping country isn't listed in any other zone's countries)
// — see lib/checkout.ts. Lazily seeded with placeholder figures on first
// admin visit (src/app/admin/shipping-zones/page.tsx), same
// self-provisioning convention lib/media.ts's bucket uses.
model ShippingZone {
  id         String   @id @default(cuid())
  label      String
  countries  String[]
  isFallback Boolean  @default(false)

  ratePerOrderLKR Float
  sortOrder       Int     @default(0)
  active          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A flat shipping cost for a specific item, keyed by weight band rather
// than destination (e.g. "Up to 100g") — for an item whose shipping cost
// is dominated by its own size/fragility rather than distance. Assigning
// one to a Gemstone/JewelryPiece REPLACES the destination-based
// ShippingZone rate for that item at checkout (see buildCheckoutBreakdown
// in lib/checkout.ts); an item with neither a tier nor quoteShipping set
// keeps using the zone rate exactly as before. Same self-provisioning/
// admin-editable convention as ShippingZone.
model ShippingWeightTier {
  id    String @id @default(cuid())
  label String

  ratePerOrderLKR Float
  sortOrder       Int     @default(0)
  active          Boolean @default(true)

  gemstones Gemstone[]
  jewelry   JewelryPiece[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton row (id is always the literal string "singleton") of
// admin-editable commerce settings — read/created lazily via
// lib/commerce-settings.ts's getCommerceSettings(), the same
// self-provisioning pattern lib/media.ts uses for its storage bucket,
// rather than depending on the seed script (so it works on the existing
// prod DB too, with no migration-time data needed).
model CommerceSettings {
  id String @id @default("singleton")

  // Sri Lanka's standard VAT rate — confirmed 18% as of this writing, but
  // it has changed before, hence admin-editable rather than hardcoded.
  vatPercent              Float   @default(18)
  // Real Sri Lankan VAT practice zero-rates exports; toggle this on only
  // if the business wants to charge VAT on international orders too.
  applyVatToInternational Boolean @default(false)

  // PayHere's actual negotiated commission — placeholder until the admin
  // fills in the real contracted rate. handlingFeeAmount on an Order is
  // (gatewayCommissionPercent + handlingFeeMarginPercent)% of the
  // gateway-charged amount (subtotal - discounts + tax + shipping).
  gatewayCommissionPercent Float @default(3.5)
  handlingFeeMarginPercent Float @default(1)

  birthdayDiscountPercent Float @default(10)

  // Every order is charged in USD through PayHere regardless of shipping
  // destination — PayHere itself settles USD (and EUR/GBP/AUD) as well as
  // LKR, so a Sri Lankan customer's card issuer converts USD to LKR at
  // the card network's own real-time rate when the charge settles, not
  // via anything this app computes. The one remaining use for this rate
  // is converting EMS's own LKR-denominated rate card (see ShippingZone)
  // into USD to fold into that all-USD total — there's no live FX API in
  // scope for that either; admin updates this periodically.
  usdToLkrRate Float @default(300)

  // Opt-in — null (the default) disables free shipping entirely, keeping
  // every existing order's shipping math unchanged until an admin sets one.
  // Each is in its own store's native currency (same convention as
  // LoyaltySettings' LKR-specific rate fields), and only waives the
  // destination ShippingZone rate on an order with at least one untiered
  // item — a weight-tiered item's own flat rate is a deliberate per-item
  // exception (usually for something heavy/oversized) and stays chargeable
  // regardless of order size. See lib/checkout.ts's buildCheckoutBreakdown.
  freeShippingThresholdUsd Float?
  freeShippingThresholdLkr Float?

  updatedAt DateTime @updatedAt
}

// ---------- Rate limiting ----------
//
// A minimal fixed-window counter, Postgres-backed rather than an in-memory
// map or a new Redis dependency: this app runs on Vercel (serverless), so
// an in-memory counter wouldn't survive across function instances, and
// there's no Redis anywhere else in the stack. One row per (action,
// identifier) pair — e.g. "login:user@example.com" or "login:203.0.113.4"
// — atomically incremented-or-reset by a single upsert query (see
// lib/rate-limit.ts's checkRateLimit) rather than a read-then-write, so two
// concurrent requests against the same key can't both slip through a
// stale count.
model RateLimitBucket {
  id          String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
